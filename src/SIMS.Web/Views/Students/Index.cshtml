@model IReadOnlyList<SIMS.Domain.Students.Student>
@{
    ViewData["Title"] = "Sinh viên";
    var activeCount = Model.Count(student => student.Status == SIMS.Domain.Students.StudentStatus.Active);
}

<header class="page-head">
    <div class="page-head__text">
        <span class="eyebrow">Học vụ</span>
        <h1>Sinh viên</h1>
        <p class="page-head__sub">
            @Model.Count hồ sơ · <span class="tnum">@activeCount</span> đang học
        </p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Import">Import CSV/Excel</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Export">Xuất CSV</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Export" asp-route-format="xlsx">Xuất Excel</a>
        <a class="btn btn-primary btn-sm" asp-action="Create">+ Thêm sinh viên</a>
    </div>
</header>

@if (Model.Count == 0)
{
    <div class="section">
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Title = "Chưa có sinh viên nào",
                     Text = "Thêm hồ sơ đầu tiên hoặc import từ CSV/Excel để bắt đầu quản lý.",
                     ActionText = "+ Thêm sinh viên",
                     ActionUrl = Url.Action("Create")
                 })" />
    </div>
}
else
{
    <section class="section" data-table data-page-size="10">
        <partial name="_TableToolbar" model="@(new TableToolbarModel
                 {
                     Placeholder = "Tìm theo MSSV, họ tên, email…"
                 })" />

        <div class="table-shell">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col" data-sort>MSSV</th>
                        <th scope="col" data-sort>Họ tên</th>
                        <th scope="col" data-sort>Email</th>
                        <th scope="col" data-sort>Ngày sinh</th>
                        <th scope="col" data-sort>Chương trình</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="col-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td><code>@student.StudentCode</code></td>
                            <td class="fw-medium">@student.FullName</td>
                            <td class="muted">@student.Email</td>
                            <td class="col-num" data-value="@student.DateOfBirth.ToString("yyyy-MM-dd")">
                                @student.DateOfBirth.ToString("dd/MM/yyyy")
                            </td>
                            <td>@student.Program</td>
                            <td>
                                @if (student.Status == SIMS.Domain.Students.StudentStatus.Active)
                                {
                                    <span class="badge badge--ok badge--dot">Đang học</span>
                                }
                                else
                                {
                                    <span class="badge badge--neutral badge--dot">Ngừng</span>
                                }
                            </td>
                            <td class="col-actions">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@student.Id">Xem</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@student.Id">Sửa</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@student.Id">Xoá</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_TableFoot" />
    </section>
}
