@model SIMS.Web.Models.CourseFormModel
@{
    var isEdit = ViewData["IsEdit"] as bool? ?? false;
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="form-grid">
    <div class="form-field">
        <label asp-for="Code" class="form-label">Mã học phần <span class="required-mark" aria-hidden="true">*</span></label>
        @if (isEdit)
        {
            <input asp-for="Code" class="form-control" readonly />
        }
        else
        {
            <input asp-for="Code" class="form-control" autocomplete="off" placeholder="VD: CS101" required />
        }
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>

    <div class="form-field">
        <label asp-for="Capacity" class="form-label">Sức chứa <span class="required-mark" aria-hidden="true">*</span></label>
        <input asp-for="Capacity" class="form-control" type="number" min="1" max="200" required />
        <span asp-validation-for="Capacity" class="text-danger small"></span>
    </div>

    <div class="form-field form-field--full">
        <label asp-for="Title" class="form-label">Tên học phần <span class="required-mark" aria-hidden="true">*</span></label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="form-field form-field--full">
        <label asp-for="PrerequisiteCode" class="form-label">Học phần tiên quyết</label>
        <input asp-for="PrerequisiteCode" class="form-control" placeholder="VD: CS101 — để trống nếu không có" />
        <span asp-validation-for="PrerequisiteCode" class="text-danger small"></span>
    </div>
</div>
