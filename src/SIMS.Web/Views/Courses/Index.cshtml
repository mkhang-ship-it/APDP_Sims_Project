@model IReadOnlyList<SIMS.Domain.Courses.Course>
@{
    ViewData["Title"] = "Học phần";
    var openCount = Model.Count(course => course.Status == SIMS.Domain.Courses.CourseStatus.Active);
}

<header class="page-head">
    <div class="page-head__text">
        <span class="eyebrow">Học vụ</span>
        <h1>Học phần</h1>
        <p class="page-head__sub">
            @Model.Count học phần · <span class="tnum">@openCount</span> đang mở
        </p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-primary btn-sm" asp-action="Create">+ Thêm học phần</a>
    </div>
</header>

@if (Model.Count == 0)
{
    <div class="section">
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Title = "Chưa có học phần nào",
                     Text = "Tạo học phần đầu tiên để mở đăng ký cho sinh viên.",
                     ActionText = "+ Thêm học phần",
                     ActionUrl = Url.Action("Create")
                 })" />
    </div>
}
else
{
    <section class="section" data-table data-page-size="10">
        <partial name="_TableToolbar" model="@(new TableToolbarModel
                 {
                     Placeholder = "Tìm theo mã hoặc tên học phần…"
                 })" />

        <div class="table-shell">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col" data-sort>Mã</th>
                        <th scope="col" data-sort>Tên học phần</th>
                        <th scope="col" class="col-num" data-sort>Sức chứa</th>
                        <th scope="col" data-sort>Tiên quyết</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="col-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td><code>@course.Code</code></td>
                            <td class="fw-medium">@course.Title</td>
                            <td class="col-num">@course.Capacity</td>
                            <td class="muted">@(course.PrerequisiteCode ?? "—")</td>
                            <td>
                                @if (course.Status == SIMS.Domain.Courses.CourseStatus.Active)
                                {
                                    <span class="badge badge--ok badge--dot">Đang mở</span>
                                }
                                else
                                {
                                    <span class="badge badge--neutral badge--dot">Đã đóng</span>
                                }
                            </td>
                            <td class="col-actions">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@course.Id">Xem</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@course.Id">Sửa</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@course.Id">Xoá</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_TableFoot" />
    </section>
}
