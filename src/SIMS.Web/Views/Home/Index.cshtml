@model SIMS.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Dashboard";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 11 ? "Chào buổi sáng" : hour < 14 ? "Chào buổi trưa" : hour < 18 ? "Chào buổi chiều" : "Chào buổi tối";
    var next = Model.NextEvents;
    var gradedShare = Model.ActiveEnrolments > 0
        ? (int)Math.Round(Model.GradedEnrolments * 100d / Model.ActiveEnrolments)
        : 0;
}

<div class="dash-hero">
    <div>
        <span class="eyebrow">Tổng quan</span>
        <h1>@greeting, @Model.DisplayName</h1>
        <p>@Model.RoleName · @DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</p>
    </div>
    <div class="dash-hero__actions">
        @if (User.IsInRole("Admin") || User.IsInRole("Faculty"))
        {
            <a class="btn btn-sm btn-secondary" asp-controller="Events" asp-action="Create">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                Sự kiện mới
            </a>
        }
        <a class="btn btn-sm btn-primary" asp-controller="Notifications" asp-action="Inbox">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 5 2 7 2 7H4s2-2 2-7" /><path d="M10 19a2 2 0 0 0 4 0" /></svg>
            Hộp thư
            @if (Model.UnreadNotifications > 0)
            {
                <span class="nav-link__count" aria-label="@Model.UnreadNotifications chưa đọc">@Model.UnreadNotifications</span>
            }
        </a>
    </div>
</div>

@if (Model.CanSeeDashboard)
{
    <section class="kpi-grid" aria-label="Số liệu tổng quan">
        <a class="kpi kpi--accent" asp-controller="Students" asp-action="Index">
            <span class="kpi__head">
                <span class="kpi__label">Sinh viên</span>
                <span class="kpi__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="3.5" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
                </span>
            </span>
            <span class="kpi__value tnum">@Model.StudentCount</span>
            <span class="kpi__foot">Quản lý danh sách</span>
        </a>

        <a class="kpi" asp-controller="Courses" asp-action="Index">
            <span class="kpi__head">
                <span class="kpi__label">Học phần</span>
                <span class="kpi__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" /><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20v3H6.5" /></svg>
                </span>
            </span>
            <span class="kpi__value tnum">@Model.CourseCount</span>
            <span class="kpi__foot">Danh mục học phần</span>
        </a>

        <a class="kpi" asp-controller="Enrolments" asp-action="Index">
            <span class="kpi__head">
                <span class="kpi__label">Đăng ký đang học</span>
                <span class="kpi__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 11l3 3 8-8" /><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9" /></svg>
                </span>
            </span>
            <span class="kpi__value tnum">@Model.ActiveEnrolments</span>
            <span class="kpi__foot">Đã có điểm: @Model.GradedEnrolments</span>
        </a>

        <a class="kpi" asp-controller="Clubs" asp-action="Index">
            <span class="kpi__head">
                <span class="kpi__label">Câu lạc bộ</span>
                <span class="kpi__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="9" cy="9" r="3" /><circle cx="16.5" cy="10.5" r="2.5" /><path d="M3 20a6 6 0 0 1 12 0M15 20a5 5 0 0 1 6.5-4.8" /></svg>
                </span>
            </span>
            <span class="kpi__value tnum">@Model.ClubCount</span>
            <span class="kpi__foot">@Model.UpcomingEventCount sự kiện sắp tới</span>
        </a>
    </section>

    <div class="dash-grid">
        <div class="stack">
            <section class="panel" aria-labelledby="events-heading">
                <div class="panel__head">
                    <h2 class="panel__title" id="events-heading">Sự kiện sắp diễn ra</h2>
                    <a class="panel__meta" asp-controller="Events" asp-action="Index">Xem tất cả</a>
                </div>
                @if (next.Count == 0)
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 11h18" /></svg>
                        <p class="empty-state__title">Chưa có sự kiện sắp tới</p>
                        <p class="empty-state__text">Sự kiện đã công bố và chưa kết thúc sẽ xuất hiện ở đây.</p>
                    </div>
                }
                else
                {
                    <div class="table-shell">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Sự kiện</th>
                                    <th scope="col">Bắt đầu</th>
                                    <th scope="col">Địa điểm</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in next)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.Title</td>
                                        <td class="tnum muted">@item.StartsAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="muted">@item.Location</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="panel" aria-labelledby="progress-heading">
                <div class="panel__head">
                    <h2 class="panel__title" id="progress-heading">Tỷ lệ hoàn thành điểm</h2>
                    <span class="panel__meta tnum">@gradedShare%</span>
                </div>
                <div class="panel__body">
                    <div class="meter">
                        <div class="meter__label">
                            <span>Đã nhập điểm / Đăng ký đang học</span>
                            <span class="tnum">@Model.GradedEnrolments / @Model.ActiveEnrolments</span>
                        </div>
                        <div class="meter__bar" role="progressbar" aria-valuenow="@gradedShare" aria-valuemin="0"
                             aria-valuemax="100" aria-label="Tỷ lệ đã nhập điểm">
                            <div class="meter__fill" style="width:@(gradedShare)%"></div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="stack">
            <section class="panel" aria-labelledby="quick-heading">
                <div class="panel__head">
                    <h2 class="panel__title" id="quick-heading">Thao tác nhanh</h2>
                </div>
                <div class="panel__body">
                    <div class="quick-grid">
                        <a class="quick-action" asp-controller="Students" asp-action="Create">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                            Thêm sinh viên
                        </a>
                        <a class="quick-action" asp-controller="Events" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 11h18" /></svg>
                            Lịch sự kiện
                        </a>
                        <a class="quick-action" asp-controller="Invoices" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z" /><path d="M9 8h6M9 12h6" /></svg>
                            Hoá đơn
                        </a>
                        <a class="quick-action" asp-controller="Checkin" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><path d="M14 14h3v3h-3zM20 20h1" /></svg>
                            Check-in QR
                        </a>
                    </div>
                </div>
            </section>

            <section class="panel" aria-labelledby="system-heading">
                <div class="panel__head">
                    <h2 class="panel__title" id="system-heading">Hệ thống</h2>
                    <span class="panel__meta">@Model.EnvironmentName</span>
                </div>
                <div class="panel__body">
                    <dl class="meta-list">
                        <div>
                            <dt>Runtime</dt>
                            <dd>@Model.FrameworkDescription</dd>
                        </div>
                        <div>
                            <dt>Lưu trữ</dt>
                            <dd>SQL Server</dd>
                        </div>
                        <div>
                            <dt>Sức khoẻ</dt>
                            <dd><a href="/health">/health</a></dd>
                        </div>
                    </dl>
                </div>
            </section>
        </div>
    </div>
}
else
{
    <div class="dash-grid">
        <section class="panel" aria-labelledby="wel-heading">
            <div class="panel__head">
                <h2 class="panel__title" id="wel-heading">Hoạt động của bạn</h2>
            </div>
            <div class="panel__body">
                <div class="quick-grid">
                    <a class="quick-action" asp-controller="MyLearning" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" /></svg>
                        Học tập của tôi
                    </a>
                    <a class="quick-action" asp-controller="Clubs" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="9" cy="9" r="3" /><circle cx="16.5" cy="10.5" r="2.5" /><path d="M3 20a6 6 0 0 1 12 0" /></svg>
                        Câu lạc bộ
                    </a>
                    <a class="quick-action" asp-controller="Notifications" asp-action="Inbox">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 5 2 7 2 7H4s2-2 2-7" /></svg>
                        Thông báo
                    </a>
                    <a class="quick-action" asp-controller="Profile" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
                        Hồ sơ
                    </a>
                </div>
            </div>
        </section>
    </div>
}
