@model SIMS.Web.Models.ClubFormModel
@{
    ViewData["Title"] = "Thêm CLB";
}

<header class="page-head">
    <div class="page-head__text">
        <span class="eyebrow">Câu lạc bộ</span>
        <h1>Thêm câu lạc bộ</h1>
        <p class="page-head__sub">Mã CLB dùng để tham chiếu trong sự kiện, hoá đơn và báo cáo.</p>
    </div>
</header>

<section class="section form-panel">
    <div class="section__head">
        <div class="section__titles">
            <h2 class="section__title">Thông tin câu lạc bộ</h2>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="section__body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="Code" class="form-label">Mã CLB <span class="required-mark" aria-hidden="true">*</span></label>
                    <input asp-for="Code" class="form-control" autocomplete="off" placeholder="VD: CLB01" required />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Name" class="form-label">Tên CLB <span class="required-mark" aria-hidden="true">*</span></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a class="btn btn-outline-secondary" asp-action="Index">Huỷ</a>
            <button type="submit" class="btn btn-primary">Tạo câu lạc bộ</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
