@model IReadOnlyList<SIMS.Web.Models.ClubListItem>
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Câu lạc bộ";
    var currentClubId = ViewData["CurrentClubId"] as Guid?;
    var canCreate = (await AuthorizationService.AuthorizeAsync(User, Context, "perm:clubs:create")).Succeeded;
    var canEdit = (await AuthorizationService.AuthorizeAsync(User, Context, "perm:clubs:edit")).Succeeded;
}

<header class="page-head">
    <div class="page-head__text">
        <span class="eyebrow">Câu lạc bộ</span>
        <h1>Câu lạc bộ</h1>
        <p class="page-head__sub">@Model.Count câu lạc bộ · CLB đang chọn áp dụng cho toàn bộ trang quản trị.</p>
    </div>
    @if (canCreate)
    {
        <div class="page-head__actions">
            <a class="btn btn-primary btn-sm" asp-action="Create">+ Thêm CLB</a>
        </div>
    }
</header>

@if (Model.Count == 0)
{
    <div class="section">
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Title = "Chưa có câu lạc bộ nào",
                     Text = "Tạo câu lạc bộ đầu tiên để quản lý thành viên và sự kiện.",
                     ActionText = canCreate ? "+ Thêm CLB" : null,
                     ActionUrl = canCreate ? Url.Action("Create") : null
                 })" />
    </div>
}
else
{
    <section class="section" data-table data-page-size="10">
        <partial name="_TableToolbar" model="@(new TableToolbarModel
                 {
                     Placeholder = "Tìm theo mã hoặc tên CLB…"
                 })" />

        <div class="table-shell">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col" data-sort>Mã</th>
                        <th scope="col" data-sort>Tên CLB</th>
                        <th scope="col" class="col-num" data-sort>Thành viên</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="col-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isCurrent = currentClubId == item.Club.Id;
                        <tr>
                            <td><code>@item.Club.Code</code></td>
                            <td>
                                <span class="fw-medium">@item.Club.Name</span>
                                @if (isCurrent)
                                {
                                    <span class="badge badge--accent ms-1">Đang chọn</span>
                                }
                            </td>
                            <td class="col-num">@item.MemberCount</td>
                            <td>
                                @if (item.Club.IsActive)
                                {
                                    <span class="badge badge--ok badge--dot">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge badge--neutral badge--dot">Đã đóng</span>
                                }
                            </td>
                            <td class="col-actions">
                                @if (canEdit)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Club.Id">Quản lý</a>
                                }
                                @if (!isCurrent)
                                {
                                    <form asp-action="Switch" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="clubId" value="@item.Club.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Chuyển sang</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_TableFoot" />
    </section>
}
