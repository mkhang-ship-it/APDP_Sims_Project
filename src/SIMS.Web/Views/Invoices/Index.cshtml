@model SIMS.Web.Models.InvoiceListPageModel
@using SIMS.Domain.Finance
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Hoá đơn";
    var canCreate = (await AuthorizationService.AuthorizeAsync(User, Context, "perm:invoices:create")).Succeeded;
    var canEdit = (await AuthorizationService.AuthorizeAsync(User, Context, "perm:invoices:edit")).Succeeded;
    var canDelete = (await AuthorizationService.AuthorizeAsync(User, Context, "perm:invoices:delete")).Succeeded;

    string Label(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Paid => "Đã thanh toán",
        InvoiceStatus.Overdue => "Quá hạn",
        _ => "Chờ thanh toán",
    };

    string BadgeClass(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Paid => "badge--ok",
        InvoiceStatus.Overdue => "badge--danger",
        _ => "badge--warn",
    };
}

<header class="page-head">
    <div class="page-head__text">
        <span class="eyebrow">Tài chính</span>
        <h1>Hoá đơn</h1>
        <p class="page-head__sub">
            @Model.Summary.Total hoá đơn · <span class="tnum">@Model.Summary.Pending</span> chờ thu
        </p>
    </div>
    <div class="page-head__actions">
        @if (canEdit)
        {
            <form asp-action="MarkOverdue" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm">Cập nhật quá hạn</button>
            </form>
        }
        @if (canCreate)
        {
            <a class="btn btn-primary btn-sm" asp-action="Create">Tạo hoá đơn</a>
        }
    </div>
</header>

<div class="stat-grid" style="margin-bottom:16px">
    <div class="stat">
        <div class="stat__label">Tổng hoá đơn</div>
        <div class="stat__value">@Model.Summary.Total</div>
    </div>
    <div class="stat">
        <div class="stat__label">Chờ thu (gồm quá hạn)</div>
        <div class="stat__value" style="color:var(--warn)">@Model.Summary.Pending</div>
    </div>
    <div class="stat">
        <div class="stat__label">Đã thu</div>
        <div class="stat__value" style="color:var(--ok)">@Model.Summary.PaidAmount.ToString("N0") đ</div>
    </div>
    <div class="stat">
        <div class="stat__label">Còn phải thu</div>
        <div class="stat__value" style="color:var(--danger)">@Model.Summary.OutstandingAmount.ToString("N0") đ</div>
    </div>
</div>

<form method="get" class="section" style="margin-bottom:16px">
    <div class="section__body" style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap">
        <div class="form-field" style="min-width:220px">
            <label class="form-label" for="status">Trạng thái</label>
            <select class="form-select" id="status" name="status">
                <option value="">Tất cả</option>
                @foreach (var value in Enum.GetValues<InvoiceStatus>())
                {
                    if (string.Equals(Model.Status, value.ToString(), StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@value" selected>@Label(value)</option>
                    }
                    else
                    {
                        <option value="@value">@Label(value)</option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-outline-secondary">Lọc</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="section">
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Title = "Chưa có hoá đơn",
                     Text = "Tạo hoá đơn đầu tiên hoặc đổi bộ lọc trạng thái để xem dữ liệu khác.",
                     ActionText = canCreate ? "Tạo hoá đơn" : null,
                     ActionUrl = canCreate ? Url.Action("Create") : null
                 })" />
    </div>
}
else
{
    <section class="section" data-table data-page-size="10">
        <partial name="_TableToolbar" model="@(new TableToolbarModel
                 {
                     Placeholder = "Tìm theo mã, thành viên, nội dung…"
                 })" />

        <div class="table-shell">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col" data-sort>Mã</th>
                        <th scope="col" data-sort>Thành viên</th>
                        <th scope="col" data-sort>Nội dung</th>
                        <th scope="col" class="col-num" data-sort>Tổng</th>
                        <th scope="col" class="col-num" data-sort>Đã thu</th>
                        <th scope="col" class="col-num" data-sort>Còn lại</th>
                        <th scope="col" data-sort>Hạn</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var invoice = item.Row.Invoice;
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@invoice.Id"><code>@invoice.Code</code></a>
                            </td>
                            <td class="fw-medium">@item.MemberName</td>
                            <td>@invoice.Title</td>
                            <td class="col-num">@invoice.TotalAmount.ToString("N0")</td>
                            <td class="col-num" style="color:var(--ok)">@item.Row.PaidAmount.ToString("N0")</td>
                            <td class="col-num" style="color:var(--danger)">@item.Row.Remaining.ToString("N0")</td>
                            <td class="col-num" data-value="@invoice.DueDate.ToString("yyyy-MM-dd")">
                                @invoice.DueDate.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <span class="badge @BadgeClass(invoice.Status) badge--dot">@Label(invoice.Status)</span>
                            </td>
                            <td class="col-actions">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@invoice.Id">Xem</a>
                                @if (canEdit && invoice.IsEditable)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@invoice.Id">Sửa</a>
                                }
                                @if (canDelete && invoice.IsEditable)
                                {
                                    <form asp-action="Delete" asp-route-id="@invoice.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xoá</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_TableFoot" />
    </section>
}
