@model SIMS.Web.Models.EmptyStateModel
<div class="empty-state">
    <span class="empty-state__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M5 7h14M5 12h9M5 17h6" stroke-linecap="round" />
            <circle cx="18" cy="16" r="2.6" />
            <path d="m20 18 1.6 1.6" stroke-linecap="round" />
        </svg>
    </span>
    <p class="empty-state__title">@Model.Title</p>
    @if (!string.IsNullOrWhiteSpace(Model.Text))
    {
        <p class="empty-state__text">@Model.Text</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionUrl))
    {
        <a class="btn btn-primary btn-sm mt-2" href="@Model.ActionUrl">@Model.ActionText</a>
    }
</div>
