@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@inject SIMS.Application.Settings.ISettingsService SettingsService
@{
    var siteTitle = await SettingsService.GetAsync(null, SIMS.Application.Settings.SettingKeys.SiteTitle) ?? "SIMS";
    var themeMode = await SettingsService.GetAsync(null, SIMS.Application.Settings.SettingKeys.SiteTheme) == "dark"
        ? "dark"
        : "light";
    // Accent chuẩn V1 là #F26522; chỉ override khi cài đặt khác mặc định cũ (#0d6efd).
    var primaryColor = await SettingsService.GetAsync(null, SIMS.Application.Settings.SettingKeys.SitePrimaryColor);
    if (string.Equals(primaryColor, "#0d6efd", StringComparison.OrdinalIgnoreCase))
    {
        primaryColor = null;
    }
    var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? string.Empty;
    var currentAction = (string?)ViewContext.RouteData.Values["action"] ?? string.Empty;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    // Tên hiển thị + chữ cái đầu cho avatar.
    var displayName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name ?? string.Empty;
    var roleName = User.FindFirstValue(ClaimTypes.Role) ?? string.Empty;
    var initial = string.IsNullOrWhiteSpace(displayName)
        ? "?"
        : displayName.Trim()[..1].ToUpperInvariant();

    string Active(string controller, string? action = null)
        => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
           && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "is-active"
            : string.Empty;

    async Task<bool> CanAsync(string module, string action)
        => (await AuthorizationService.AuthorizeAsync(User, Context, $"perm:{module}:{action}")).Succeeded;
}
<!DOCTYPE html>
<html lang="vi" data-theme="@themeMode" data-bs-theme="@themeMode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - @siteTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(primaryColor) && primaryColor != "#f26522")
    {
        <style>
            :root { --accent: @primaryColor; }
        </style>
    }
    <script>
        // Áp theme đã lưu trước khi vẽ để không nháy trắng.
        (function () {
            try {
                var saved = localStorage.getItem('sims-theme');
                if (saved === 'light' || saved === 'dark') {
                    document.documentElement.setAttribute('data-theme', saved);
                    document.documentElement.setAttribute('data-bs-theme', saved);
                }
            } catch (e) { /* chế độ riêng tư: bỏ qua */ }
        })();
    </script>
</head>
<body>
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>

    <div class="app-shell" id="app-shell">
        <aside class="app-sidebar" id="app-sidebar" aria-label="Điều hướng chính">
            <a class="app-brand" asp-controller="Home" asp-action="Index">
                <span class="app-brand__mark" aria-hidden="true">S</span>
                <span class="app-brand__name">
                    <span class="app-brand__title">@siteTitle</span>
                    @if (isAuthenticated)
                    {
                        <span class="app-brand__club">@roleName</span>
                    }
                </span>
            </a>

            <nav class="app-nav" aria-label="Danh mục">
                <div class="nav-group">
                    <span class="nav-group__label">Tổng quan</span>
                    <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">
                        <span class="nav-link__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 10.5 12 3l9 7.5V21H3z" /></svg>
                        </span>
                        <span class="nav-link__text">Dashboard</span>
                    </a>
                    @if (isAuthenticated)
                    {
                        <a class="nav-link @Active("Notifications", "Inbox")" asp-controller="Notifications" asp-action="Inbox">
                            <span class="nav-link__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 8a6 6 0 1 1 12 0c0 5 2 7 2 7H4s2-2 2-7" /><path d="M10 19a2 2 0 0 0 4 0" /></svg>
                            </span>
                            <span class="nav-link__text">Thông báo</span>
                        </a>
                    }
                </div>

                @if (isAuthenticated)
                {
                    var menu = new (string Label, string Module, string Action, string Controller, string? Action2, string Text)[]
                    {
                        ("Học vụ", "students", "view", "Students", "Index", "Sinh viên"),
                        ("Học vụ", "courses", "view", "Courses", "Index", "Học phần"),
                        ("Học vụ", "enrolments", "view", "Enrolments", "Index", "Đăng ký"),
                        ("Học vụ", "learning", "view_own", "MyLearning", "Index", "Học tập của tôi"),
                        ("Câu lạc bộ", "clubs", "view", "Clubs", "Index", "Câu lạc bộ"),
                        ("Câu lạc bộ", "events", "view", "Events", "Index", "Sự kiện"),
                        ("Câu lạc bộ", "checkin", "create", "Checkin", "Index", "Check-in"),
                        ("Tài chính", "invoices", "view", "Invoices", "Index", "Hoá đơn"),
                        ("Tài chính", "invoices", "my_invoices", "Invoices", "MyInvoices", "Hoá đơn của tôi"),
                        ("Tài chính", "expenses", "view", "Expenses", "Index", "Chi phí"),
                        ("Tài chính", "expenses", "my_expenses", "Expenses", "MyExpenses", "Chi phí của tôi"),
                        ("Văn bản & khen thưởng", "documents", "view", "Documents", "Index", "Văn bản"),
                        ("Văn bản & khen thưởng", "documents", "my_documents", "Documents", "My", "Văn bản của tôi"),
                        ("Văn bản & khen thưởng", "discipline", "view", "Disciplines", "Index", "Kỷ luật"),
                        ("Văn bản & khen thưởng", "discipline", "my_points", "Disciplines", "MyPoints", "Điểm của tôi"),
                        ("Văn bản & khen thưởng", "awards", "view", "Awards", "Index", "Khen thưởng"),
                        ("Văn bản & khen thưởng", "lucky_draws", "view", "LuckyDraws", "Index", "Bốc thăm"),
                        ("Hệ thống", "short_urls", "view", "ShortUrls", "Index", "Link rút gọn"),
                        ("Hệ thống", "feature_requests", "view", "FeatureRequests", "Index", "Đề xuất"),
                        ("Hệ thống", "logs", "view", "Logs", "Index", "Nhật ký"),
                    };

                    var allowed = new List<(string Label, string Controller, string? Action, string Text)>();
                    foreach (var item in menu)
                    {
                        if (await CanAsync(item.Module, item.Action))
                        {
                            allowed.Add((item.Label, item.Controller, item.Action2, item.Text));
                        }
                    }

                    foreach (var group in allowed.GroupBy(item => item.Label))
                    {
                        <div class="nav-group">
                            <span class="nav-group__label">@group.Key</span>
                            @foreach (var item in group)
                            {
                                <a class="nav-link @Active(item.Controller, item.Action)"
                                   asp-controller="@item.Controller" asp-action="@item.Action">
                                    <span class="nav-link__text">@item.Text</span>
                                </a>
                            }
                        </div>
                    }

                    <div class="nav-group">
                        <span class="nav-group__label">Tài khoản</span>
                        @if (await CanAsync("settings", "admin"))
                        {
                            <a class="nav-link @Active("Settings", "Global")" asp-controller="Settings" asp-action="Global">
                                <span class="nav-link__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" /></svg>
                                </span>
                                <span class="nav-link__text">Cài đặt</span>
                            </a>
                        }
                        else if (await CanAsync("settings", "club"))
                        {
                            <a class="nav-link @Active("Settings", "Club")" asp-controller="Settings" asp-action="Club">
                                <span class="nav-link__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" /></svg>
                                </span>
                                <span class="nav-link__text">Cài đặt CLB</span>
                            </a>
                        }
                        <a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">
                            <span class="nav-link__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="3.5" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
                            </span>
                            <span class="nav-link__text">Hồ sơ</span>
                        </a>
                        <a class="nav-link @Active("Home", "Privacy")" asp-controller="Home" asp-action="Privacy">
                            <span class="nav-link__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9" /><path d="M12 16v-4M12 8h.01" /></svg>
                            </span>
                            <span class="nav-link__text">Giới thiệu</span>
                        </a>
                    </div>
                }
            </nav>

            <div class="app-sidebar__footer">
                <button type="button" class="nav-link" id="theme-toggle" aria-live="polite">
                    <span class="nav-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" id="theme-icon">
                            <circle cx="12" cy="12" r="4.5" />
                            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
                        </svg>
                    </span>
                    <span class="nav-link__text" id="theme-label">Giao diện sáng</span>
                </button>
            </div>
        </aside>

        <button type="button" class="sidebar-scrim" id="sidebar-scrim" aria-label="Đóng menu" tabindex="-1"></button>

        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="icon-btn sidebar-toggle" id="sidebar-toggle"
                        aria-controls="app-sidebar" aria-expanded="false" aria-label="Mở menu điều hướng">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>

                @if (isAuthenticated)
                {
                    <button type="button" class="topbar-search" id="search-trigger"
                            aria-haspopup="dialog" aria-label="Tìm kiếm nhanh (Ctrl K)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                        <span>Tìm trang, chức năng…</span>
                        <kbd class="topbar-kbd">Ctrl K</kbd>
                    </button>
                }

                <span class="app-topbar__spacer"></span>

                <a class="icon-btn" asp-controller="Notifications" asp-action="Inbox" aria-label="Thông báo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 5 2 7 2 7H4s2-2 2-7" /><path d="M10 19a2 2 0 0 0 4 0" /></svg>
                </a>
                <button type="button" class="icon-btn" id="theme-toggle-top" aria-label="Đổi giao diện sáng/tối">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.8 6.8 0 0 0 9.8 9.8z" />
                    </svg>
                </button>

                <span class="topbar-divider" aria-hidden="true"></span>

                @if (isAuthenticated)
                {
                    <button type="button" class="user-chip" id="user-menu-trigger"
                            aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu">
                        <span class="avatar" aria-hidden="true">@initial</span>
                        <span class="user-chip__meta">
                            <span class="user-chip__name">@displayName</span>
                            <span class="user-chip__role">@roleName</span>
                        </span>
                    </button>
                    <div class="menu-panel" id="user-menu" role="menu" aria-label="Tài khoản" hidden>
                        <div class="menu-panel__section">@displayName</div>
                        <a class="menu-item" role="menuitem" asp-controller="Profile" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
                            Hồ sơ cá nhân
                        </a>
                        <a class="menu-item" role="menuitem" asp-controller="Notifications" asp-action="Inbox">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 5 2 7 2 7H4s2-2 2-7" /><path d="M10 19a2 2 0 0 0 4 0" /></svg>
                            Thông báo
                        </a>
                        <div class="menu-separator" role="separator"></div>
                        <button type="button" class="menu-item" role="menuitem" id="theme-toggle-menu">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2" /></svg>
                            Đổi giao diện
                        </button>
                        <div class="menu-separator" role="separator"></div>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="menu-item" role="menuitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M15 17l5-5-5-5M20 12H9M12 3H5v18h7" /></svg>
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                }
            </header>

            <main id="main-content" class="app-content" role="main" tabindex="-1">
                @if (TempData["Status"] is string statusMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="status">
                        @statusMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                    </div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; 2026 @siteTitle</span>
                <span>
                    <a href="/health">Trạng thái hệ thống</a>
                    <span aria-hidden="true"> · </span>
                    <a asp-controller="Home" asp-action="Privacy">Giới thiệu</a>
                </span>
            </footer>
        </div>
    </div>

    @if (isAuthenticated)
    {
        <div class="cmdk" id="cmdk" role="dialog" aria-modal="true" aria-label="Tìm kiếm nhanh" hidden>
            <div class="cmdk__box">
                <input type="text" class="cmdk__input" id="cmdk-input" placeholder="Nhập tên trang hoặc chức năng…"
                       role="combobox" aria-expanded="true" aria-controls="cmdk-list" aria-autocomplete="list" />
                <ul class="cmdk__list" id="cmdk-list" role="listbox" aria-label="Kết quả"></ul>
                <div class="cmdk__foot">
                    <span><kbd class="topbar-kbd">↑↓</kbd> di chuyển</span>
                    <span><kbd class="topbar-kbd">Enter</kbd> mở</span>
                    <span><kbd class="topbar-kbd">Esc</kbd> đóng</span>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
