@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi hệ thống";
}

<div class="state-page">
    <span class="state-page__code">500</span>
    <h1 class="state-page__title">Đã xảy ra lỗi</h1>
    <p class="state-page__text">
        Yêu cầu không xử lý được. Vui lòng thử lại; nếu lỗi tiếp diễn, gửi mã yêu cầu cho quản trị viên.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="state-page__meta">
            Mã yêu cầu: <code>@Model.RequestId</code>
        </p>
    }

    <div class="state-page__actions">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
        <a class="btn btn-outline-secondary" href="/health">Trạng thái hệ thống</a>
    </div>
</div>
